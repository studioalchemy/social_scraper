# Copy this to .env.local for local development
# Set this to your Railway backend URL in production (Vercel env vars)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared-secret bearer token. Must match the API_BEARER_TOKEN env var set on
# the backend (Railway). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Note: NEXT_PUBLIC_* values are baked into the JS bundle and visible to anyone
# who reads page source. Treat as a "trivial-attacker deterrent", not a strong secret.
NEXT_PUBLIC_API_TOKEN=replace-me-with-the-same-value-as-API_BEARER_TOKEN-on-the-backend
