# Copy this to .env.local for local development.
#
# Both vars are read SERVER-SIDE only (no NEXT_PUBLIC_ prefix), by the
# proxy at app/api/[...path]/route.ts. They never reach the browser.

# Backend URL the proxy forwards to. localhost:8000 for dev, Railway URL in prod.
BACKEND_API_URL=http://localhost:8000

# Shared-secret bearer token — must match API_BEARER_TOKEN on the backend.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_TOKEN=replace-me-with-the-same-value-as-API_BEARER_TOKEN-on-the-backend
